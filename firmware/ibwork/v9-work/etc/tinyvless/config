# tinyvless — конфигурация (правится через LuCI или вручную)
VLESS_LINK=''
MODE=selective
REDIR_PORT=1082
TPROXY_PORT=1083
# Zapret (обход DPI для доменов из zapret_domains.list). 0=выкл 1=вкл.
ZAPRET_ENABLE=0
# RU_SET=1 — полный гео-набор (8626 подсетей, ~2.4МБ RAM). Правильный дефолт:
# нагружает туннель ТОЛЬКО реально зарубежным трафиком; RU-сайты идут напрямую.
# RU_SET=0 испробован под research-нагрузкой — давал ОБРАТНЫЙ эффект: без CIDR-набора
# весь трафик (включая RU-сайты вне 47 доменов) шёл через туннель → tinyvless OOM.
RU_SET=1
# SELECT_LEVEL: low = RU/direct напрямую, остальное в туннель (классика).
#               high = только tunnel_domains.list в туннель, всё остальное напрямую (экономия RAM).
SELECT_LEVEL=low
# UDP_TUNNEL: full = весь UDP через tproxy; discord = только Discord-порты (экономия под MacBook).
UDP_TUNNEL=full

# DNS-резолв
# DNS_PRIMARY/DNS_FALLBACK — обычные (не-DoH) резолверы, используются для всего, кроме доменов
# из poisoned_domains.list. Дефолт — два независимых адреса Яндекс DNS (не блокируются Yota,
# подтверждено 2026-07-08: корректно резолвят RU И зарубежные домены, включая Instagram, БЕЗ DoH).
DNS_PRIMARY=77.88.8.8
DNS_FALLBACK=77.88.8.1
# DOH_MODE: off = только PRIMARY/FALLBACK, DoH не используется вообще.
#           smart = PRIMARY/FALLBACK для всего + DoH точечно для доменов из poisoned_domains.list.
#           full = ВСЁ через DoH-туннель (старое поведение, максимально безопасно но медленнее).
DOH_MODE=smart
