#!/bin/sh
# LAN на 192.168.10.1 — постоянный адрес проекта (не дефолтный 192.168.1.1 OpenWrt), чтобы не
# конфликтовать с типичными домашними роутерами на .1.1. ВАЖНО: маска обязательна (/24) —
# без неё интерфейс поднимается с битым netmask (ARP отвечает, а IP-уровень не работает).
uci -q batch <<-EOF
	set network.lan.ipaddr='192.168.10.1/24'
	commit network
EOF
exit 0
