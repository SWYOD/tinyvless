#!/bin/sh /etc/rc.common
# tinyvless — VLESS+WS/TLS клиент с прозрачным перехватом (REDIRECT TCP + TPROXY UDP)
# и селективным роутингом (RU напрямую / зарубеж в туннель / тумблер режима).

USE_PROCD=1
START=95
STOP=10

CONF=/etc/tinyvless/config

start_service() {
	[ -f "$CONF" ] || return 1
	# shellcheck disable=SC1090
	. "$CONF"
	[ -n "$VLESS_LINK" ] || return 1
	MODE="${MODE:-selective}"
	REDIR_PORT="${REDIR_PORT:-1082}"
	TPROXY_PORT="${TPROXY_PORT:-1083}"

	procd_open_instance
	# GODEBUG=asyncpreemptoff=1 — КРИТИЧНО: без него Go-рантайм на mipsel уходит в CPU-спин (100%).
	# Задаём через env-префикс в команде (переживает respawn, в отличие от procd env-параметра).
	procd_set_param command /usr/bin/env GODEBUG=asyncpreemptoff=1 /usr/bin/tinyvless \
		-redir "0.0.0.0:$REDIR_PORT" \
		-tproxy "0.0.0.0:$TPROXY_PORT" \
		-status "127.0.0.1:19999" \
		-link "$VLESS_LINK"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# провязка роутинга (nft/ip rule) — сервер исключаем из туннеля
	apply_routing "$MODE" "$VLESS_LINK" "$REDIR_PORT" "$TPROXY_PORT"
}

stop_service() {
	TV_REDIR_PORT= TV_TPROXY_PORT= /etc/tinyvless/tvroute.sh off 2>/dev/null
}

# apply_routing <mode> <link> <redir_port> <tproxy_port>
apply_routing() {
	mode="$1"; link="$2"; rport="$3"; tport="$4"
	# извлекаем хост сервера из vless://uuid@HOST:PORT?...
	host=$(echo "$link" | sed -n 's#^vless://[^@]*@\([^:/?]*\).*#\1#p')
	sip=""
	if [ -n "$host" ]; then
		sip=$(nslookup "$host" 2>/dev/null | grep '^Address' | grep -v ':53' | tail -1 | sed 's/.* //')
	fi
	export TV_SERVER_IP="${sip:-$host}"
	export TV_REDIR_PORT="$rport"
	export TV_TPROXY_PORT="$tport"
	export TV_RU_NFT=/etc/tinyvless/ru_cidr.nft
	export TV_BYPASS_SRC   # список src-IP в обход туннеля (из config, опционально)
	export TV_BYPASS_MAC   # список src-MAC в обход туннеля (устойчиво к смене IP)
	# небольшая пауза, чтобы клиент успел поднять сокеты
	sleep 2
	/etc/tinyvless/tvroute.sh "$mode"
	# домены из пользовательских списков -> nft-сеты (через dnsmasq nftset)
	[ -x /etc/tinyvless/domains.sh ] && /etc/tinyvless/domains.sh >/dev/null 2>&1
}

reload_service() {
	stop
	start
}
