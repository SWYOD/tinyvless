#!/bin/sh /etc/rc.common
# tinyvless-dns — procd-обёртка для dns-watchdog.sh (авто-восстановление dnsmasq после OOM).

USE_PROCD=1
START=97
STOP=89

start_service() {
	procd_open_instance
	procd_set_param command /etc/tinyvless/dns-watchdog.sh
	procd_set_param respawn 3600 5 0
	procd_set_param nice 19
	procd_close_instance
}

stop_service() {
	killall dns-watchdog.sh 2>/dev/null
}
