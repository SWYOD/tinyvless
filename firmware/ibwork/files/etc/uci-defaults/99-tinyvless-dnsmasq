#!/bin/sh
# Выполняется ОДИН раз при первой загрузке после прошивки (стандартный механизм uci-defaults).
# Ограничивает кэш dnsmasq — на дефолтных 1000 записей RSS разрастался до 8.8МБ на 58МБ-роутере
# под многодоменной нагрузкой и dnsmasq дважды был OOM-killed (полный отказ DNS для сети).
uci set dhcp.@dnsmasq[0].cachesize=300
uci commit dhcp
exit 0
