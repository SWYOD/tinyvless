#!/bin/sh /etc/rc.common
# tinyvless — VLESS+WS/TLS клиент с прозрачным перехватом (REDIRECT TCP + TPROXY UDP)
# и селективным роутингом (RU напрямую / зарубеж в туннель / тумблер режима).

USE_PROCD=1
START=95
STOP=10

CONF=/etc/tinyvless/config

start_service() {
	[ -f "$CONF" ] || return 1
	# shellcheck disable=SC1090
	. "$CONF"
	[ -n "$VLESS_LINK" ] || return 1
	MODE="${MODE:-selective}"
	REDIR_PORT="${REDIR_PORT:-1082}"
	TPROXY_PORT="${TPROXY_PORT:-1083}"

	procd_open_instance
	# GODEBUG=asyncpreemptoff=1 — КРИТИЧНО: без него Go-рантайм на mipsel уходит в CPU-спин (100%).
	# Задаём через env-префикс в команде (переживает respawn, в отличие от procd env-параметра).
	# nice -n 10 — ПОНИЖЕННЫЙ приоритет CPU (2026-07-08): на единственном ядре 385МГц tinyvless
	# конкурировал за CPU с time-sensitive обработкой WiFi-драйвера (netlink/маячки) → периодические
	# `nl80211_recv_beacons failed: -5` → клиенты не могли пройти авторизацию и отваливались с AP.
	# Подтверждено экспериментом: с остановленным туннелем ошибки driver'а пропадали полностью.
	# nice ниже приоритета отдаёт CPU-цикл WiFi-стеку первым при конкуренции — крипто/nftables
	# работа tinyvless не столь time-sensitive, задержка в неё не ломает функциональность.
	procd_set_param command nice -n 10 /usr/bin/env GODEBUG=asyncpreemptoff=1 /usr/bin/tinyvless \
		-redir "0.0.0.0:$REDIR_PORT" \
		-tproxy "0.0.0.0:$TPROXY_PORT" \
		-status "127.0.0.1:19999" \
		-link "$VLESS_LINK"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# провязка роутинга (nft/ip rule) — сервер исключаем из туннеля.
	# небольшая пауза, чтобы клиент успел поднять сокеты, затем apply-route.sh.
	(sleep 2; /etc/tinyvless/apply-route.sh "$MODE") &
}

stop_service() {
	# off = снести только цепочки, СОХРАНИВ набор ru_cidr — чтобы restart (смена профиля)
	# не перегружал 8600 подсетей заново (~25с CPU). Полная очистка набора (purge) —
	# только на явном power-off из морды (api.sh stop).
	TV_REDIR_PORT= TV_TPROXY_PORT= /etc/tinyvless/tvroute.sh off 2>/dev/null
}

reload_service() {
	stop
	start
}
