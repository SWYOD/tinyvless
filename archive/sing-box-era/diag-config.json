{
  "log": { "level": "debug", "timestamp": true },
  "dns": {
    "servers": [ { "tag": "direct-dns", "address": "223.5.5.5", "detour": "direct" } ],
    "final": "direct-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    { "type": "mixed", "tag": "socks-in", "listen": "127.0.0.1", "listen_port": 1080 }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-out",
      "server": "example.your-vless-server.tld",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "tls": { "enabled": true, "server_name": "example.your-vless-server.tld" },
      "transport": { "type": "ws", "path": "/nl-avt", "headers": { "Host": "example.your-vless-server.tld" } }
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": { "default_domain_resolver": "direct-dns", "final": "vless-out" }
}
