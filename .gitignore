# OpenWrt ImageBuilder SDK (downloaded, not our code) + build output
firmware/ibwork/ib/
firmware/ibwork/out/

# Build-time staging/snapshot dirs — generated by build-image-*.sh, duplicate what's
# already versioned directly in git (etc/www/usr) — git history replaces the need for these.
**/.staging-files-*/
**/snapshot-*/

# Firmware binaries — published as GitHub Release assets, not committed as blobs
releases/*.bin

# Router backups — contain real VLESS profiles, WiFi password, SSH host private key
releases/backups/

# Local secrets — never commit
scripts/rssh.local.env

# macOS
.DS_Store
